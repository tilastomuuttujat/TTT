
  const orderedEdges=visibleEdges.slice().sort((a,b)=>{const ah=highlightedNode&&nearbyNodeIds.has(a.s.id)&&nearbyNodeIds.has(a.t.id)?1:0;const bh=highlightedNode&&nearbyNodeIds.has(b.s.id)&&nearbyNodeIds.has(b.t.id)?1:0;return ah-bh||a.conf-b.conf;});
  orderedEdges.forEach((edge)=>{
    const sourcePoint=screen(pos(edge.s)),targetPoint=screen(pos(edge.t));
    if(Math.max(sourcePoint.x,targetPoint.x)<-60||Math.min(sourcePoint.x,targetPoint.x)>W+60)return;
    const highlighted=!highlightedNode||(nearbyNodeIds.has(edge.s.id)&&nearbyNodeIds.has(edge.t.id));
    if(edge.kind==="rel"){canvasContext.strokeStyle=`rgba(150,162,176,${highlighted?.3:.035})`;canvasContext.lineWidth=.7*Math.min(1.7,viewState.k);}else{const gradient=canvasContext.createLinearGradient(sourcePoint.x,sourcePoint.y,targetPoint.x,targetPoint.y);const opacity=highlighted?.16+edge.conf*.55:.035;gradient.addColorStop(0,`rgba(99,197,218,${opacity})`);gradient.addColorStop(1,edge.t.kind==="s"?hexA(edge.t.color,opacity):`rgba(230,169,78,${opacity})`);canvasContext.strokeStyle=gradient;canvasContext.lineWidth=(.45+edge.conf*2)*Math.min(1.7,viewState.k)*(highlighted&&highlightedNode?1.5:1);}
    edgePath(sourcePoint,targetPoint,edge);canvasContext.stroke();
    if(highlighted&&highlightedNode&&edge.kind==="cw"&&viewState.glow){const progress=(time*.35+edge.conf*3)%1,pulsePoint=quadAt(sourcePoint,targetPoint,progress,edge);canvasContext.fillStyle=`rgba(255,238,200,${.5*(1-Math.abs(progress-.5)*1.4)})`;canvasContext.beginPath();canvasContext.arc(pulsePoint.x,pulsePoint.y,1.7,0,Math.PI*2);canvasContext.fill();}
  });
  visibleNodes.forEach((node)=>{const point=screen(pos(node));if(point.x<-40||point.x>W+40||point.y<-40||point.y>H+40)return;const nodeRadius=radius(node)*clamp(viewState.k,.7,1.6),highlighted=(!highlightedNode||nearbyNodeIds.has(node.id))&&!node.dim,selectedOrHovered=node===viewState.sel||node===viewState.hover;canvasContext.globalAlpha=highlighted?1:.13;if(viewState.glow&&highlighted&&(node.deg>=4||selectedOrHovered)){const glow=canvasContext.createRadialGradient(point.x,point.y,0,point.x,point.y,nodeRadius*4.5);glow.addColorStop(0,hexA(node.color,selectedOrHovered?.38:.2));glow.addColorStop(1,hexA(node.color,0));canvasContext.fillStyle=glow;canvasContext.beginPath();canvasContext.arc(point.x,point.y,nodeRadius*4.5,0,Math.PI*2);canvasContext.fill();}canvasContext.beginPath();canvasContext.arc(point.x,point.y,nodeRadius,0,Math.PI*2);canvasContext.fillStyle=node.color;canvasContext.fill();canvasContext.lineWidth=1;canvasContext.strokeStyle="rgba(8,9,12,.85)";canvasContext.stroke();if(node===viewState.sel){const selectionRadius=nodeRadius+4+(viewState.glow?Math.sin(time*3)*1.2:0);canvasContext.lineWidth=1.6;canvasContext.strokeStyle="rgba(255,255,255,.9)";canvasContext.beginPath();canvasContext.arc(point.x,point.y,selectionRadius,0,Math.PI*2);canvasContext.stroke();}canvasContext.globalAlpha=1;});
  if(viewState.labels)drawLabels(highlightedNode,nearbyNodeIds);
}
function quadAt(sourcePoint,targetPoint,progress,edge){let controlX,controlY;if(viewState.view==="timeline"){controlX=(sourcePoint.x+targetPoint.x)/2;controlY=(sourcePoint.y+targetPoint.y)/2-Math.abs(targetPoint.y-sourcePoint.y)*.1-Math.abs(targetPoint.x-sourcePoint.x)*.13;}else if(viewState.view==="radial"){const center=screen({x:W/2,y:H/2});controlX=lerp(center.x,(sourcePoint.x+targetPoint.x)/2,.25);controlY=lerp(center.y,(sourcePoint.y+targetPoint.y)/2,.25);}else{const deltaX=targetPoint.x-sourcePoint.x,deltaY=targetPoint.y-sourcePoint.y,length=Math.hypot(deltaX,deltaY)||1,curveAmount=clamp(length*.06,4,46);controlX=(sourcePoint.x+targetPoint.x)/2-(deltaY/length)*curveAmount*.35;controlY=(sourcePoint.y+targetPoint.y)/2+(deltaX/length)*curveAmount*.35;}const inverseProgress=1-progress;return{x:inverseProgress*inverseProgress*sourcePoint.x+2*inverseProgress*progress*controlX+progress*progress*targetPoint.x,y:inverseProgress*inverseProgress*sourcePoint.y+2*inverseProgress*progress*controlY+progress*progress*targetPoint.y};}
function hexA(hexColor,alphaValue){const normalized=hexColor.replace("#","");const numericValue=parseInt(normalized.length===3?normalized.split("").map((c)=>c+c).join(""):normalized,16);return`rgba(${(numericValue>>16)&255},${(numericValue>>8)&255},${numericValue&255},${alphaValue})`;}
function drawLabels(highlightedNode,nearbyNodeIds){canvasContext.font="11.5px ui-sans-serif,system-ui,sans-serif";canvasContext.textBaseline="middle";const drawnPositions=[];visibleNodes.slice().sort((a,b)=>(b===viewState.sel)-(a===viewState.sel)||b.deg-a.deg).forEach((node)=>{const point=screen(pos(node)),highlighted=(!highlightedNode||nearbyNodeIds.has(node.id))&&!node.dim;if(!highlighted)return;const minimumDegree=W<620?8:3,showLabel=node.deg>=(highlightedNode?0:minimumDegree)||viewState.k>1.5||node===viewState.sel||node===viewState.hover;if(!showLabel||point.x<-40||point.x>W+40||point.y<8||point.y>H-8)return;const verticalGap=W<620?24:13;if(node!==viewState.sel&&drawnPositions.some((p)=>Math.abs(p.y-point.y)<verticalGap&&Math.abs(p.x-point.x)<150))return;drawnPositions.push(point);const maximumCharacters=W<620?24:36,label=node.label.length>maximumCharacters?node.label.slice(0,maximumCharacters-1)+"…":node.label,textWidth=canvasContext.measureText(label).width;let placeOnLeft=viewState.view==="radial"?point.x<W/2:node.kind==="m";if(!placeOnLeft&&point.x+radius(node)+10+textWidth>W-6)placeOnLeft=true;if(placeOnLeft&&point.x-radius(node)-10-textWidth<6)placeOnLeft=false;const horizontalOffset=placeOnLeft?-(radius(node)*clamp(viewState.k,.7,1.6)+7):radius(node)*clamp(viewState.k,.7,1.6)+7;canvasContext.textAlign=placeOnLeft?"right":"left";const backgroundX=point.x+horizontalOffset-(placeOnLeft?textWidth+4:-2);canvasContext.fillStyle="rgba(8,9,12,.72)";roundRect(backgroundX,point.y-8,textWidth+6,16,4);canvasContext.fill();canvasContext.fillStyle=node===viewState.sel||node===viewState.hover?"#fff":"rgba(233,228,218,.8)";canvasContext.fillText(label,point.x+horizontalOffset,point.y);});}
function roundRect(x,y,width,height,radiusValue){canvasContext.beginPath();canvasContext.moveTo(x+radiusValue,y);canvasContext.arcTo(x+width,y,x+width,y+height,radiusValue);canvasContext.arcTo(x+width,y+height,x,y+height,radiusValue);canvasContext.arcTo(x,y+height,x,y,radiusValue);canvasContext.arcTo(x,y,x+width,y,radiusValue);canvasContext.closePath();}
function drawAxis(){canvasContext.save();canvasContext.font="10px ui-monospace,monospace";canvasContext.textAlign="center";canvasContext.textBaseline="top";const padding=86,availableWidth=Math.max(220,W-padding*2);for(let year=Math.ceil(minimumYear/20)*20;year<=maximumYear;year+=20){const point=screen({x:padding+((year-minimumYear)/(maximumYear-minimumYear||1))*availableWidth,y:0});if(point.x<30||point.x>W-8)continue;const majorYear=year%100===0;canvasContext.strokeStyle=majorYear?"rgba(255,255,255,.10)":"rgba(255,255,255,.04)";canvasContext.beginPath();canvasContext.moveTo(point.x,18);canvasContext.lineTo(point.x,H-30);canvasContext.stroke();if(majorYear||viewState.k>1.2){canvasContext.fillStyle=majorYear?"rgba(200,206,214,.75)":"rgba(125,135,146,.6)";canvasContext.fillText(year,point.x,H-24);}}canvasContext.textAlign="left";canvasContext.font="10px ui-monospace,monospace";canvasContext.fillStyle="rgba(99,197,218,.85)";canvasContext.fillText("MURROSATLAS",14,H*.33-10);canvasContext.fillStyle="rgba(230,169,78,.85)";canvasContext.fillText("SELITYSATLAS",14,H*.71-10);canvasContext.restore();}
function drawRing(){const center=screen({x:W/2,y:H/2}),ringRadius=(RAD.R||200)*viewState.k;canvasContext.strokeStyle="rgba(255,255,255,.05)";canvasContext.lineWidth=1;canvasContext.beginPath();canvasContext.arc(center.x,center.y,ringRadius,0,Math.PI*2);canvasContext.stroke();canvasContext.font="10px ui-monospace,monospace";canvasContext.textAlign="center";canvasContext.fillStyle="rgba(99,197,218,.7)";canvasContext.fillText("MURROKSET",center.x+ringRadius*.72,center.y-ringRadius-14);canvasContext.fillStyle="rgba(230,169,78,.7)";canvasContext.fillText("TEEMAT",center.x-ringRadius*.72,center.y+ringRadius+18);}
