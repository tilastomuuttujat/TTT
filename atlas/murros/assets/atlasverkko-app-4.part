
function hitTest(mouseX,mouseY){let bestNode=null,bestDistance=20;visibleNodes.forEach((node)=>{const point=screen(pos(node)),distance=Math.hypot(point.x-mouseX,point.y-mouseY),hitRadius=Math.max(10,radius(node)*clamp(viewState.k,.7,1.6)+6);if(distance<hitRadius&&distance<bestDistance){bestDistance=distance;bestNode=node;}});return bestNode;}
let drag=null;
canvas.addEventListener("pointerdown",(event)=>{canvas.setPointerCapture(event.pointerId);drag={x:event.offsetX,y:event.offsetY,node:hitTest(event.offsetX,event.offsetY),moved:false};});
canvas.addEventListener("pointerup",()=>{if(drag&&!drag.moved)select(drag.node);drag=null;});
canvas.addEventListener("pointercancel",()=>{drag=null;});
canvas.addEventListener("pointermove",(event)=>{const mouseX=event.offsetX,mouseY=event.offsetY;if(drag){if(Math.hypot(mouseX-drag.x,mouseY-drag.y)>3)drag.moved=true;if(drag.node){const node=drag.node,zoom=viewState.k;if(viewState.view==="network"){node.x+=(mouseX-drag.x)/zoom;node.y+=(mouseY-drag.y)/zoom;}else{node.tx+=(mouseX-drag.x)/zoom;node.ty+=(mouseY-drag.y)/zoom;}alpha=Math.max(alpha,.12);}else{viewState.tx+=mouseX-drag.x;viewState.ty+=mouseY-drag.y;viewState.txt=viewState.tx;viewState.tyt=viewState.ty;}drag.x=mouseX;drag.y=mouseY;draw();return;}const hoveredNode=hitTest(mouseX,mouseY);if(hoveredNode!==viewState.hover){viewState.hover=hoveredNode;draw();}const tooltip=getElement("tip");if(hoveredNode){tooltip.classList.add("on");const atlasName=hoveredNode.kind==="m"?"Murrosatlas · "+escapeHtml(hoveredNode.type):"Selitysatlas · "+escapeHtml(CATEGORY_STYLES[hoveredNode.type]?.n||"");tooltip.innerHTML=`<div class="k">${atlasName}</div><b>${escapeHtml(hoveredNode.label)}</b><div class="k" style="margin-top:4px">${hoveredNode.y0||"?"}–${hoveredNode.y1||"?"} · ${hoveredNode.deg} crosswalk ${hoveredNode.rdeg?" · "+hoveredNode.rdeg+" relaatiota":""}</div>`;const rect=tooltip.getBoundingClientRect();tooltip.style.left=clamp(mouseX+16,8,canvas.clientWidth-rect.width-8)+"px";tooltip.style.top=Math.max(8,mouseY-rect.height-12)+"px";getElement("hoverInfo").textContent=hoveredNode.id;canvas.style.cursor="pointer";}else{tooltip.classList.remove("on");getElement("hoverInfo").textContent="";canvas.style.cursor=drag?"grabbing":"grab";}});
canvas.addEventListener("wheel",(event)=>{event.preventDefault();const zoomFactor=Math.exp(-event.deltaY*.0013),mouseX=event.offsetX,mouseY=event.offsetY,newZoom=clamp(viewState.k*zoomFactor,.2,7),relativeZoom=newZoom/viewState.k;viewState.tx=mouseX-W/2-(mouseX-W/2-viewState.tx)*relativeZoom;viewState.ty=mouseY-H/2-(mouseY-H/2-viewState.ty)*relativeZoom;viewState.k=newZoom;viewState.ktarget=newZoom;viewState.txt=viewState.tx;viewState.tyt=viewState.ty;draw();},{passive:false});
canvas.addEventListener("mouseleave",()=>{getElement("tip").classList.remove("on");viewState.hover=null;draw();});
canvas.addEventListener("dblclick",resetCam);
function setFocus(enabled){if(enabled&&!viewState.sel)return;viewState.focus=enabled;getElement("focusPill").hidden=!enabled;getElement("focusBtn").classList.toggle("on",enabled);refresh(true);if(enabled){seed();alpha=1;}}
function goTo(node){if(!node)return;if(!node.vis){viewState.onlyLinked=false;getElement("onlyLinked").checked=false;getElement("onlyLinked").closest("label").classList.remove("on");if(node.kind==="s")viewState.cats.add(node.type);else viewState.types.add(node.type);document.querySelectorAll("#cats label,#types label").forEach((row)=>{if(row.dataset.key===node.type){row.querySelector("input").checked=true;row.classList.add("on");}});refresh(true);}select(node);const point=pos(node);viewState.txt=(W/2-point.x)*viewState.ktarget;viewState.tyt=(H/2-point.y)*viewState.ktarget;getElement("detail").classList.add("open");}
function select(node){viewState.sel=node;if(viewState.focus)refresh(true);renderDetail(node);draw();}
function renderDetail(node){const detailBody=getElement("detailBody");if(!node){detailBody.innerHTML=`<div class="id">Atlasverkko · ohje</div><h3>Kaksi atlasta, yksi verkko</h3><p class="hint"><b>Siniset</b> solmut ovat Murrosatlaksen murroksia ja <b>värilliset</b> Selitysatlaksen teemoja (K kriisi, R rakenne, S siirtymä). Viivojen paksuus ja kirkkaus kertovat crosswalk-yhteyden luottamuksesta.</p><p class="hint">Klikkaa solmua nähdäksesi kuvauksen, mekanismin, seuraukset ja linkit. Vieritä zoomataksesi ja raahaa siirtääksesi näkymää tai solmua.</p><div class="divider"></div><div class="id">Näkymät</div><p class="hint" style="margin-top:8px"><b>Verkko</b> -- kaksijakoinen asettelu yhteyksien mukaan.<br><b>Kehä</b> -- murrokset ja teemat kehällä.<br><b>Aikajana</b> -- kaikki kohteet vuosiakselilla.</p><div class="divider"></div><div class="id">Pikanäppäimet</div><p class="hint" style="margin-top:8px"><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> näkymä · <kbd>F</kbd> tarkennus · <kbd>L</kbd> nimilaput · <kbd>0</kbd> sovita · <kbd>/</kbd> haku · <kbd>Esc</kbd> tyhjennä</p>`;return;}
const linkedItems=(adjacency.get(node.id)||[]).filter((a)=>a.o.vis||!viewState.onlyLinked),crosswalkItems=linkedItems.filter((a)=>a.l.kind==="cw").sort((a,b)=>b.l.conf-a.l.conf),relationItems=(adjacency.get(node.id)||[]).filter((a)=>a.l.kind==="rel"),averageConfidence=crosswalkItems.length?crosswalkItems.reduce((sum,a)=>sum+a.l.conf,0)/crosswalkItems.length:0,categoryLabel=node.kind==="m"?node.type:CATEGORY_STYLES[node.type]?.n||"";
detailBody.innerHTML=`<div class="id">${escapeHtml(node.id)} · ${node.kind==="m"?"Murrosatlas":"Selitysatlas"}</div><h3>${escapeHtml(node.label)}</h3><div class="meta"><span class="tag" style="border-color:${node.color};color:${node.color}">${escapeHtml(categoryLabel)}</span><span class="tag">${node.y0||"?"}–${node.y1||"?"}</span>${(node.domains||[]).slice(0,5).map((domain)=>`<span class="tag">${escapeHtml(domain)}</span>`).join("")}${node.evidence?`<span class="tag" style="color:var(--amber)">${escapeHtml(node.evidence)}</span>`:""}</div><div class="kpi"><div><b>${node.deg}</b><span>Crosswalk</span></div><div><b>${node.rdeg}</b><span>Relaatiot</span></div><div><b>${averageConfidence?averageConfidence.toFixed(2):"–"}</b><span>Luottamus ⌀</span></div></div>${node.text?`<p class="lead">${escapeHtml(node.text)}</p>`:""}${node.mech?`<div class="sec"><h2>Mekanismi</h2><p>${escapeHtml(node.mech)}</p></div>`:""}${node.effects&&node.effects.length?`<div class="sec"><h2>Seuraukset</h2><ul class="bullets">${node.effects.slice(0,6).map((effect)=>`<li>${escapeHtml(effect)}</li>`).join("")}</ul></div>`:""}<div class="sec"><h2>Crosswalk-linkit (${crosswalkItems.length})</h2>${crosswalkItems.length?crosswalkItems.map((a)=>`<div class="linkrow" data-go="${escapeHtml(a.o.id)}"><i class="swatch" style="background:${a.o.color};color:${a.o.color}"></i><span>${escapeHtml(a.o.label)}</span><i class="bar" style="width:${Math.round(a.l.conf*26)}px;opacity:${.3+a.l.conf*.7}"></i><span class="c">${a.l.conf.toFixed(2)}</span></div>`).join(""):`<p class="hint">Ei linkkejä nykyisillä suodattimilla.</p>`}</div>${relationItems.length?`<div class="sec"><h2>Murrosrelaatiot (${relationItems.length})</h2>${relationItems.slice(0,18).map((a)=>`<div class="linkrow" data-go="${escapeHtml(a.o.id)}"><span>${escapeHtml(a.o.label)}</span><span class="c">${escapeHtml(a.l.type||"")}</span></div>`).join("")}</div>`:""}`;
detailBody.querySelectorAll("[data-go]").forEach((row)=>row.addEventListener("click",()=>goTo(nodeById.get(row.dataset.go))));detailBody.scrollTop=0;getElement("detail").scrollTop=0;}
function shot(){const link=document.createElement("a");link.download="atlasverkko-"+viewState.view+".png";link.href=canvas.toDataURL("image/png");link.click();}
function loop(){for(let iteration=0;iteration<3;iteration+=1)tick();const zoomDifference=viewState.ktarget-viewState.k,horizontalDifference=viewState.txt-viewState.tx,verticalDifference=viewState.tyt-viewState.ty,cameraIsMoving=Math.abs(zoomDifference)>.0001||Math.abs(horizontalDifference)>.4||Math.abs(verticalDifference)>.4;if(cameraIsMoving){viewState.k+=zoomDifference*.16;viewState.tx+=horizontalDifference*.16;viewState.ty+=verticalDifference*.16;}if(viewState.view==="network"&&alpha>=.004){if(alpha<.05&&!fitted){fitted=true;fitView();}draw();}else if(cameraIsMoving||((viewState.sel||viewState.hover)&&viewState.glow))draw();else if(!fitted){fitted=true;fitView();}requestAnimationFrame(loop);}
yearSync();resize();renderDetail(null);refresh(true);loop();const hash=decodeURIComponent(location.hash.slice(1));if(hash&&nodeById.has(hash))setTimeout(()=>goTo(nodeById.get(hash)),400);
